{
  "manifest_version": 3,
  "name": "Skyfold – Safari Bookmarks",
  "short_name": "Safari Bookmarks",
  "version": "1.0.0",
  "description": "Your Safari bookmarks from iCloud, kept up to date in a \"Safari Bookmarks\" folder. Needs the free Skyfold app for Windows.",
  "homepage_url": "https://github.com/zoranmod/skyfold",
  "permissions": ["bookmarks", "nativeMessaging", "storage", "alarms"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Safari Bookmarks", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "key": ""
}
